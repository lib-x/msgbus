[Unit]
Description=msgbus local message daemon
Documentation=https://github.com/lib-x/msgbus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
Environment=RUST_LOG=info
Environment=MSGBUS_LISTEN=127.0.0.1:50051
Environment=MSGBUS_DATA=/var/lib/msgbus/msgbus.redb
Environment=MSGBUS_STORAGE=redb
Environment=MSGBUS_TENANT_ID=tenant
Environment=MSGBUS_BL_NAME=default
Environment=MSGBUS_DEVICE_ID=device
ExecStart=/usr/local/bin/msgbusd
Restart=on-failure
RestartSec=2s
StateDirectory=msgbus
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/msgbus

[Install]
WantedBy=multi-user.target
